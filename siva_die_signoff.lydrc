report("SIVA MULTI-TILE DIE SIGN-OFF DRC - REV-4.3.3 ANTI-COLLAPSE")

source_base = source("SIVA_MATRIX_BASE.gds")
source_cap = source("SIVA_MATRIX_CAP.gds")

m5 = source_base.input(31, 0)
met_pad = source_base.input(33, 0)
seal_ring = source_base.input(90, 0)
deep_trench = source_base.input(100, 0)
m6 = source_cap.input(32, 0)
dimple = source_cap.input(45, 0)

# --- 1. VERIFICATION OF CMOS BASE ---
m5.width(2.0.um).output("DRC_M5_WIDTH", "Width M5 < 2.0um")
m5.space(1.0.um).output("DRC_M5_SPACE", "Space M5 < 1.0um")
met_pad.width(2.0.um).output("DRC_PAD_WIDTH", "Width PAD < 2.0um")
met_pad.space(2.0.um).output("DRC_PAD_SPACE", "Space PAD < 2.0um")

# --- 2. VERIFICATION OF RESONATOR CAP ---
m6.holes.output("DRC_M6_ROOF", "Hole in M6 roof not allowed")

# --- 2.1 TILE COUNT CHECK (DOCKER-STABLE FIXED) ---
if m6.polygons.count != 16
  m6.output("DRC_M6_COUNT_ERROR", "Layout must contain exactly 16 tiles (found #{m6.polygons.count})")
end

# --- 2.2 DIMPLES (TOPOLOGY ONLY, NO IP DISCLOSURE) ---
dimple.non_rectangles.output("DRC_DIMPLE_IS_NOT_RECT", "Dimple geometry must be rectangular")
dimple.not(m6).output("DRC_DIMPLE_OUTSIDE", "Dimple layer detected outside the active M6 roof zone")

# --- 2.3 ANTI-COLLAPSE FIX (REV-4.3.3) ---
# FIX Капкана 1: Зазор 87.5um > 44um, даем допуск 0.1um на Docker/float глюк
m6.enclosing(dimple, 43.9.um).output("DRC_DIMPLE_MARGIN", "Dimple to M6 edge < 44um - Roof collapse risk")
# FIX Капкана 2: Зазор 85.0um ровно на границе DBU, даем допуск 0.1um
dimple.space(84.9.um).output("DRC_DIMPLE_SPACE", "Dimple pitch < 85um - Roof collapse risk")

# --- 3. PERIPHERAL CONTOUR ---
deep_trench.width(5.0.um).output("DRC_TRENCH_WIDTH", "Trench width error")
seal_ring.width(10.0.um).output("DRC_SEAL_WIDTH", "Seal width error")
deep_trench.separation(seal_ring, 1.0.um).output("DRC_TRENCH_SEAL_GAP", "Gap must be >= 1.0um")
